@baseUrl = http://localhost:5104/api
@token = YOUR_JWT_HERE
@apiKey = YOUR_API_KEY_HERE
@monitorId = 00000000-0000-0000-0000-000000000000
@alertRuleId = 00000000-0000-0000-0000-000000000000

### Register a user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "ChangeMe123!",
  "firstName": "Ada",
  "lastName": "Lovelace"
}

### Log in
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "ChangeMe123!"
}

### Get the current user with a JWT
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Get the current user with an API key
GET {{baseUrl}}/auth/me
X-Api-Key: {{apiKey}}

### Regenerate the current user's API key
POST {{baseUrl}}/auth/api-key/regenerate
Authorization: Bearer {{token}}

### Create a monitor
POST {{baseUrl}}/monitors
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Marketing site",
  "url": "https://example.com",
  "protocol": "Http",
  "checkIntervalSeconds": 60,
  "timeoutSeconds": 10,
  "expectedStatusCode": 200,
  "useHeadRequest": false
}

### List monitors
GET {{baseUrl}}/monitors
Authorization: Bearer {{token}}

### Get a monitor
GET {{baseUrl}}/monitors/{{monitorId}}
Authorization: Bearer {{token}}

### Update a monitor
PUT {{baseUrl}}/monitors/{{monitorId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Marketing site",
  "checkIntervalSeconds": 120,
  "isPaused": false
}

### Pause a monitor
PATCH {{baseUrl}}/monitors/{{monitorId}}/pause
Authorization: Bearer {{token}}

### Resume a monitor
PATCH {{baseUrl}}/monitors/{{monitorId}}/resume
Authorization: Bearer {{token}}

### Get a monitor summary
GET {{baseUrl}}/monitors/{{monitorId}}/summary
Authorization: Bearer {{token}}

### Get monitor history for 7 days
GET {{baseUrl}}/monitors/{{monitorId}}/history?days=7
Authorization: Bearer {{token}}

### Get a missing monitor
GET {{baseUrl}}/monitors/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}

### Delete a monitor
DELETE {{baseUrl}}/monitors/{{monitorId}}
Authorization: Bearer {{token}}

### Create an alert rule
POST {{baseUrl}}/alerts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "monitorId": "{{monitorId}}",
  "type": "Webhook",
  "triggerType": "OnDown",
  "threshold": 1,
  "coolDownMinutes": 60,
  "target": "https://hooks.example.com/keeptabs",
  "isEnabled": true
}

### Create a Telegram alert rule
POST {{baseUrl}}/alerts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "monitorId": "{{monitorId}}",
  "type": "Telegram",
  "triggerType": "ConsecutiveFailures",
  "threshold": 3,
  "coolDownMinutes": 30,
  "target": "-1001234567890",
  "isEnabled": true
}

### List alert rules
GET {{baseUrl}}/alerts
Authorization: Bearer {{token}}

### List alert rules for a monitor
GET {{baseUrl}}/alerts?monitorId={{monitorId}}
Authorization: Bearer {{token}}

### Send a test alert
POST {{baseUrl}}/alerts/{{alertRuleId}}/test
Authorization: Bearer {{token}}

### List alert deliveries
GET {{baseUrl}}/alerts/logs
Authorization: Bearer {{token}}

### Get SMTP settings
GET {{baseUrl}}/settings/smtp
Authorization: Bearer {{token}}

### Update SMTP settings
PUT {{baseUrl}}/settings/smtp
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "enabled": true,
  "host": "smtp.example.com",
  "port": 587,
  "username": "ops",
  "password": "",
  "from": "alerts@example.com",
  "enableSsl": true
}

### Update Telegram settings
PUT {{baseUrl}}/settings/telegram
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "enabled": true,
  "botToken": ""
}
